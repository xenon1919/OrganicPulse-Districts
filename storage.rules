rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Collection photos: the partner takes this in person at pickup (shown
    // in their scan review and in the household's collection history); only
    // the partner who owns the uid-scoped folder can upload to it.
    match /collection-photos/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
